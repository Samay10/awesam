---
import DigestCard from './DigestCard.astro';
import { DIGEST_PLAN, storiesToBands } from '../lib/buildDigest';
import type { Story } from '../lib/catalog';

interface Props {
	stories: Story[];
	empty?: string;
	plan?: readonly number[];
}

const { stories, empty = 'Nothing here yet — check back soon.', plan = DIGEST_PLAN } = Astro.props;
const bands = storiesToBands(stories, plan);
---

{
	stories.length === 0 ? (
		<p class="empty">{empty}</p>
	) : (
		<div class="feed">
			{bands.map((band) => (
				<section class="band">
					<div class:list={['grid', band.cards.length >= 3 ? 'three' : 'two']}>
						{band.cards.map((card) => (
							<DigestCard card={card} />
						))}
					</div>
				</section>
			))}
		</div>
	)
}

<style>
	.feed {
		display: grid;
		gap: 1.25rem;
	}

	.band {
		display: grid;
		gap: 0.875rem;
	}

	.grid {
		display: grid;
		gap: 1.25rem;
	}

	.grid.two,
	.grid.three {
		grid-template-columns: 1fr;
	}

	.empty {
		margin: 0;
		padding: 1.2rem 0;
		font-family: var(--font-display);
		font-style: italic;
		color: var(--color-on-surface-variant);
	}

	@media (min-width: 900px) {
		.grid.two {
			grid-template-columns: 1fr 1fr;
		}

		.grid.three {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
