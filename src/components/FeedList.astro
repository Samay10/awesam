---
import type { FeedItem } from '../lib/feeds';

interface Props {
	items: FeedItem[];
	empty?: string;
	external?: boolean;
}

const { items, empty = 'Nothing on the desk yet — check back soon.', external = true } = Astro.props;
---

{
	items.length === 0 ? (
		<p class="empty">{empty}</p>
	) : (
		<ol class="marks">
			{items.map((item, index) => (
				<li class="reveal" style={`--d: ${index * 40}ms`}>
					<a
						class="mark"
						href={item.href}
						{...(external ? { target: '_blank', rel: 'noreferrer' } : {})}
					>
						<span class="idx">{String(index + 1).padStart(2, '0')}</span>
						<span class="body">
							<span class="title">{item.title}</span>
							{item.summary && <span class="summary">{item.summary}</span>}
							<span class="meta">
								{item.source}
								{item.meta ? ` · ${item.meta}` : ''}
							</span>
						</span>
						<span class="arrow" aria-hidden="true">↗</span>
					</a>
				</li>
			))}
		</ol>
	)
}

<style>
	.marks {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--color-border);
	}

	.mark {
		display: grid;
		grid-template-columns: 2.4rem minmax(0, 1fr) 1.1rem;
		gap: 0.85rem;
		align-items: start;
		padding: 1.05rem 0.15rem;
		border-bottom: 1px solid var(--color-border);
	}

	.mark:hover {
		background: var(--color-surface-container-low);
	}

	.idx {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.06em;
		color: var(--color-outline);
		padding-top: 0.35rem;
	}

	.body {
		display: grid;
		gap: 0.3rem;
		min-width: 0;
	}

	.title {
		font-family: var(--font-display);
		font-size: clamp(1.05rem, 2vw, 1.35rem);
		letter-spacing: -0.02em;
		line-height: 1.25;
		font-weight: 600;
	}

	.summary,
	.meta {
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--color-on-surface-variant);
	}

	.meta {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.arrow {
		color: var(--color-outline);
		padding-top: 0.3rem;
	}

	.mark:hover .arrow {
		color: var(--color-secondary);
	}

	.empty {
		margin: 0;
		padding: 1.2rem 0;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
		font-family: var(--font-display);
		font-style: italic;
		color: var(--color-on-surface-variant);
	}

	.reveal {
		transition-delay: var(--d, 0ms);
	}

	@media (max-width: 640px) {
		.mark {
			grid-template-columns: minmax(0, 1fr) 1.1rem;
		}

		.idx {
			display: none;
		}
	}
</style>
