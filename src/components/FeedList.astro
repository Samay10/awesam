---
import DigestCard from './DigestCard.astro';
import type { DigestCard as DigestCardData, DigestSource } from '../data/digest';
import type { FeedItem } from '../lib/feeds';

interface Props {
	items: FeedItem[];
	source: DigestSource;
	empty?: string;
}

const PLAN = [2, 2, 3, 3] as const;

const CTA: Record<DigestSource, string> = {
	hn: 'Deep Dive',
	x: 'Open',
	github: 'View Repository',
	papers: 'View Preprint',
	articles: 'Read',
};

const BADGE: Record<DigestSource, string> = {
	hn: 'HN',
	x: 'X / Lab',
	github: 'GitHub',
	papers: 'ArXiv',
	articles: 'Article',
};

const { items, source, empty = 'Nothing here yet — check back soon.' } = Astro.props;

function sizeForBand(index: number): DigestCardData['size'] {
	if (index === 0) return 'lead';
	if (index === 1) return 'deep';
	return 'dense';
}

function toCard(item: FeedItem, size: DigestCardData['size']): DigestCardData {
	const stats = item.meta
		? item.meta.split('·').map((part) => part.trim()).filter(Boolean)
		: [];

	return {
		id: item.id,
		source,
		badge: source === 'x' ? item.source : BADGE[source],
		meta: '',
		title: item.title,
		abstract: item.summary ?? '',
		href: item.href,
		cta: CTA[source],
		stats,
		size,
	};
}

const bands: DigestCardData[][] = [];
let cursor = 0;
for (let i = 0; i < PLAN.length && cursor < items.length; i++) {
	const take = PLAN[i];
	bands.push(items.slice(cursor, cursor + take).map((item) => toCard(item, sizeForBand(i))));
	cursor += take;
}
if (cursor < items.length) {
	bands.push(items.slice(cursor).map((item) => toCard(item, 'dense')));
}
---

{
	items.length === 0 ? (
		<p class="empty">{empty}</p>
	) : (
		<div class="feed">
			{bands.map((cards) => (
				<section class="band">
					<div class:list={['grid', cards.length >= 3 ? 'three' : 'two']}>
						{cards.map((card) => (
							<DigestCard card={card} preview={false} />
						))}
					</div>
				</section>
			))}
		</div>
	)
}

<style>
	.feed {
		display: grid;
		gap: 1.25rem;
	}

	.band {
		display: grid;
		gap: 0.875rem;
	}

	.grid {
		display: grid;
		gap: 1.25rem;
	}

	.grid.two,
	.grid.three {
		grid-template-columns: 1fr;
	}

	.empty {
		margin: 0;
		padding: 1.2rem 0;
		font-family: var(--font-display);
		font-style: italic;
		color: var(--color-on-surface-variant);
	}

	@media (min-width: 900px) {
		.grid.two {
			grid-template-columns: 1fr 1fr;
		}

		.grid.three {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
