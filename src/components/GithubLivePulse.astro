---
import { GITHUB_WATCH_REPOS, type GithubPullSignal } from '../lib/feeds';

interface Props {
	initial: GithubPullSignal[];
}

const { initial } = Astro.props;
const repos = [...GITHUB_WATCH_REPOS];
---

<section class="pulse" id="gh-pulse" data-repos={JSON.stringify(repos)} aria-label="Recent pull requests">
	<div class="pulse-head">
		<span class="breath" aria-hidden="true"></span>
		<span class="live-label">Live</span>
	</div>

	<ol class="lanes" id="pulse-lanes" aria-live="polite">
		{
			initial.map((item, index) => (
				<li class="lane" data-id={item.id} style={`--i:${index}`}>
					<a class="lane-link" href={item.href} target="_blank" rel="noreferrer">
						<span class="repo">{item.repo}</span>
						<span class="pr">
							<span class="num">#{item.number}</span>
							<span class="title">{item.title}</span>
						</span>
						<span class="who">
							@{item.user}
							<span class="when" data-ts={item.updatedAt}></span>
						</span>
					</a>
				</li>
			))
		}
	</ol>
</section>

<script define:vars={{ initial, repos }}>
	const REFRESH_MS = 5 * 60 * 1000;
	const BATCH = 4;
	const lanes = document.getElementById('pulse-lanes');
	const root = document.getElementById('gh-pulse');

	/** @type {Map<string, any>} */
	const byRepo = new Map(initial.map((item) => [item.repo, item]));
	let cursor = 0;
	let deadline = Date.now() + REFRESH_MS;
	let breathTimer = 0;

	function relTime(iso) {
		const delta = Date.now() - new Date(iso).getTime();
		const mins = Math.max(0, Math.round(delta / 60000));
		if (mins < 1) return 'just now';
		if (mins < 60) return `${mins}m ago`;
		const hrs = Math.round(mins / 60);
		if (hrs < 48) return `${hrs}h ago`;
		return `${Math.round(hrs / 24)}d ago`;
	}

	function ranked() {
		return [...byRepo.values()].sort((a, b) => +new Date(b.updatedAt) - +new Date(a.updatedAt)).slice(0, 10);
	}

	function escapeHtml(value) {
		return String(value)
			.replace(/&/g, '&amp;')
			.replace(/</g, '&lt;')
			.replace(/>/g, '&gt;')
			.replace(/"/g, '&quot;');
	}

	function render(animateIds = new Set()) {
		if (!lanes) return;
		const items = ranked();
		lanes.innerHTML = items
			.map(
				(item, index) => `
			<li class="lane${animateIds.has(item.id) ? ' is-new' : ''}" data-id="${escapeHtml(item.id)}" style="--i:${index}">
				<a class="lane-link" href="${escapeHtml(item.href)}" target="_blank" rel="noreferrer">
					<span class="repo">${escapeHtml(item.repo)}</span>
					<span class="pr">
						<span class="num">#${escapeHtml(item.number)}</span>
						<span class="title"></span>
					</span>
					<span class="who">@${escapeHtml(item.user)}<span class="when">${escapeHtml(relTime(item.updatedAt))}</span></span>
				</a>
			</li>`,
			)
			.join('');

		[...lanes.querySelectorAll('.lane')].forEach((node, index) => {
			const title = node.querySelector('.title');
			if (title) title.textContent = items[index].title;
		});

		root?.classList.toggle('is-hot', animateIds.size > 0);
		window.clearTimeout(breathTimer);
		breathTimer = window.setTimeout(() => root?.classList.remove('is-hot'), 1800);
	}

	async function fetchRepo(repo) {
		const response = await fetch(
			`https://api.github.com/repos/${repo}/pulls?state=all&sort=updated&direction=desc&per_page=2`,
			{
				headers: {
					Accept: 'application/vnd.github+json',
					'X-GitHub-Api-Version': '2022-11-28',
				},
			},
		);
		if (!response.ok) return null;
		const pulls = await response.json();
		const pull = pulls?.[0];
		if (!pull) return null;
		return {
			id: `pr-${repo}-${pull.number}`,
			repo,
			number: pull.number,
			title: pull.title,
			href: pull.html_url,
			user: pull.user?.login ?? 'unknown',
			updatedAt: pull.updated_at,
			state: pull.state,
		};
	}

	async function refreshBatch() {
		if (document.hidden) return;
		const slice = [];
		for (let i = 0; i < BATCH; i++) {
			slice.push(repos[(cursor + i) % repos.length]);
		}
		cursor = (cursor + BATCH) % repos.length;

		const results = await Promise.all(slice.map((repo) => fetchRepo(repo).catch(() => null)));
		const changed = new Set();

		for (const item of results) {
			if (!item) continue;
			const prev = byRepo.get(item.repo);
			byRepo.set(item.repo, item);
			if (!prev || prev.id !== item.id || prev.updatedAt !== item.updatedAt) {
				changed.add(item.id);
			}
		}

		render(changed);
		deadline = Date.now() + REFRESH_MS;
	}

	document.querySelectorAll('#pulse-lanes .when[data-ts]').forEach((node) => {
		node.textContent = relTime(node.getAttribute('data-ts'));
	});

	window.setInterval(refreshBatch, REFRESH_MS);
	window.setTimeout(refreshBatch, 12_000);

	document.addEventListener('visibilitychange', () => {
		if (!document.hidden && Date.now() >= deadline - 30_000) refreshBatch();
	});
</script>

<style>
	.pulse {
		position: relative;
		display: grid;
		gap: 1rem;
		padding: 0.25rem 0 0.5rem;
		isolation: isolate;
	}

	.pulse::before {
		content: '';
		position: absolute;
		inset: -0.5rem -0.75rem auto;
		height: 5.5rem;
		border-radius: 0.35rem;
		background: radial-gradient(ellipse at 20% 40%, color-mix(in srgb, var(--color-secondary) 12%, transparent), transparent 60%),
			radial-gradient(ellipse at 80% 20%, color-mix(in srgb, var(--color-on-surface) 5%, transparent), transparent 55%);
		opacity: 0.65;
		animation: aura 7s ease-in-out infinite;
		pointer-events: none;
		z-index: -1;
	}

	.pulse.is-hot::before {
		animation-duration: 2.4s;
		opacity: 1;
	}

	.pulse-head {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.breath {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 999px;
		background: var(--color-secondary);
		box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-secondary) 55%, transparent);
		animation: breath 2.8s ease-out infinite;
	}

	.live-label {
		color: var(--color-secondary);
		font-weight: 600;
	}

	.lanes {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.35rem;
		counter-reset: lane;
	}

	.lane {
		counter-increment: lane;
		animation: settle 520ms cubic-bezier(0.22, 1, 0.36, 1) both;
		animation-delay: calc(var(--i, 0) * 35ms);
	}

	.lane.is-new {
		animation: rise 700ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.lane-link {
		display: grid;
		grid-template-columns: minmax(7.5rem, 11rem) minmax(0, 1fr) auto;
		gap: 0.75rem 1rem;
		align-items: baseline;
		padding: 0.7rem 0.85rem;
		border-radius: 0.25rem;
		background: color-mix(in srgb, var(--color-surface-light) 88%, transparent);
		border: 1px solid transparent;
		transition:
			background 180ms linear,
			border-color 180ms linear,
			transform 180ms ease;
	}

	.lane-link:hover {
		background: var(--color-surface-container-low);
		border-color: var(--color-border);
		transform: translateY(-1px);
	}

	.repo {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--color-secondary);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.repo::before {
		content: counter(lane, decimal-leading-zero) ' · ';
		color: var(--color-outline);
		font-weight: 500;
	}

	.pr {
		display: flex;
		gap: 0.45rem;
		min-width: 0;
		align-items: baseline;
	}

	.num {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--color-outline);
		flex-shrink: 0;
	}

	.title {
		font-family: var(--font-display);
		font-size: 0.98rem;
		font-weight: 600;
		letter-spacing: -0.015em;
		line-height: 1.3;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.who {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-on-surface-variant);
		white-space: nowrap;
		display: inline-flex;
		gap: 0.45rem;
	}

	.when {
		color: var(--color-outline);
	}

	@keyframes breath {
		0% {
			transform: scale(1);
			box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-secondary) 45%, transparent);
		}
		70% {
			transform: scale(1.05);
			box-shadow: 0 0 0 0.55rem transparent;
		}
		100% {
			transform: scale(1);
			box-shadow: 0 0 0 0 transparent;
		}
	}

	@keyframes aura {
		0%,
		100% {
			transform: scale(1) translateY(0);
			opacity: 0.5;
		}
		50% {
			transform: scale(1.04) translateY(2px);
			opacity: 0.85;
		}
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(-0.65rem);
			filter: blur(1px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
			filter: none;
		}
	}

	@keyframes settle {
		from {
			opacity: 0;
			transform: translateY(0.35rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 800px) {
		.lane-link {
			grid-template-columns: 1fr;
			gap: 0.25rem;
		}

		.who {
			justify-content: space-between;
		}
	}
</style>
