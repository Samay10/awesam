---
import { GITHUB_WATCH_REPOS, type GithubRepoPulse } from '../lib/feeds';

interface Props {
	initial: GithubRepoPulse[];
}

const { initial } = Astro.props;
const repos = [...GITHUB_WATCH_REPOS];
---

<section class="guns" id="gh-pulse" aria-label="Flagship repository pull requests">
	<div class="guns-head">
		<span class="breath" aria-hidden="true"></span>
		<span class="live-label">Live</span>
	</div>

	<ol class="grid" id="pulse-grid" aria-live="polite">
		{
			initial.map((row, index) => (
				<li class="box" data-repo={row.repo} style={`--i:${index}`}>
					<a class="box-head" href={row.href} target="_blank" rel="noreferrer">
						<img class="avatar" src={row.avatar} alt="" width="28" height="28" loading="lazy" />
						<span class="repo-name">
							<span class="owner">{row.owner}/</span>
							{row.name}
						</span>
					</a>
					<ol class="prs">
						{
							[0, 1, 2].map((slot) => {
								const pull = row.pulls[slot];
								return (
									<li class="pr" data-slot={slot} hidden={!pull}>
										<a href={pull?.href ?? row.href} target="_blank" rel="noreferrer">
											<span class="num">{pull ? `#${pull.number}` : ''}</span>
											<span class="title">{pull?.title ?? ''}</span>
											<span class="meta">
												<span class="user">{pull ? `@${pull.user}` : ''}</span>
												<span class="when" data-ts={pull?.updatedAt ?? ''}></span>
											</span>
										</a>
									</li>
								);
							})
						}
						<li class="empty" hidden={row.pulls.length > 0}>
							No recent PRs
						</li>
					</ol>
				</li>
			))
		}
	</ol>
</section>

<script define:vars={{ initial, repos }}>
	const REFRESH_MS = 5 * 60 * 1000;
	const BATCH = 4;
	const TIME_TICK_MS = 30_000;
	const grid = document.getElementById('pulse-grid');
	const root = document.getElementById('gh-pulse');

	/** @type {Map<string, any>} */
	const byRepo = new Map(initial.map((row) => [row.repo, row]));
	let cursor = 0;
	let deadline = Date.now() + REFRESH_MS;
	let breathTimer = 0;

	function relTime(iso) {
		const delta = Date.now() - new Date(iso).getTime();
		const mins = Math.max(0, Math.round(delta / 60000));
		if (mins < 1) return 'just now';
		if (mins < 60) return `${mins}m ago`;
		const hrs = Math.round(mins / 60);
		if (hrs < 48) return `${hrs}h ago`;
		return `${Math.round(hrs / 24)}d ago`;
	}

	function repoMeta(repo) {
		const [owner, name] = repo.split('/');
		return {
			repo,
			owner: owner ?? repo,
			name: name ?? repo,
			href: `https://github.com/${repo}`,
			avatar: `https://github.com/${owner}.png?size=80`,
		};
	}

	function paintTimes() {
		grid?.querySelectorAll('.when[data-ts]').forEach((node) => {
			const ts = node.getAttribute('data-ts');
			if (ts) node.textContent = relTime(ts);
		});
	}

	function paintRepo(repo, changed = false) {
		const row = byRepo.get(repo) ?? { ...repoMeta(repo), pulls: [] };
		const box = grid?.querySelector(`.box[data-repo="${CSS.escape(repo)}"]`);
		if (!box) return;

		const empty = box.querySelector('.empty');
		if (empty) empty.hidden = row.pulls.length > 0;

		for (let slot = 0; slot < 3; slot++) {
			const item = box.querySelector(`.pr[data-slot="${slot}"]`);
			const link = item?.querySelector('a');
			if (!item || !link) continue;

			const pull = row.pulls[slot];
			if (!pull) {
				item.hidden = true;
				continue;
			}

			item.hidden = false;
			link.href = pull.href;
			link.querySelector('.num').textContent = `#${pull.number}`;
			link.querySelector('.title').textContent = pull.title;
			link.querySelector('.user').textContent = `@${pull.user}`;
			const when = link.querySelector('.when');
			when.setAttribute('data-ts', pull.updatedAt);
			when.textContent = relTime(pull.updatedAt);
		}

		if (changed) {
			box.classList.remove('is-new');
			void box.offsetWidth;
			box.classList.add('is-new');
		}
	}

	function paintAll(changedRepos = new Set()) {
		for (const repo of repos) paintRepo(repo, changedRepos.has(repo));
		root?.classList.toggle('is-hot', changedRepos.size > 0);
		window.clearTimeout(breathTimer);
		if (changedRepos.size > 0) {
			breathTimer = window.setTimeout(() => {
				root?.classList.remove('is-hot');
				grid?.querySelectorAll('.box.is-new').forEach((box) => box.classList.remove('is-new'));
			}, 1800);
		}
	}

	async function fetchRepo(repo) {
		const response = await fetch(
			`https://api.github.com/repos/${repo}/pulls?state=all&sort=updated&direction=desc&per_page=3`,
			{
				headers: {
					Accept: 'application/vnd.github+json',
					'X-GitHub-Api-Version': '2022-11-28',
				},
			},
		);
		if (!response.ok) return null;
		const pulls = await response.json();
		return {
			...repoMeta(repo),
			pulls: (pulls ?? []).slice(0, 3).map((pull) => ({
				id: `pr-${repo}-${pull.number}`,
				repo,
				number: pull.number,
				title: pull.title,
				href: pull.html_url,
				user: pull.user?.login ?? 'unknown',
				updatedAt: pull.updated_at,
				state: pull.state,
			})),
		};
	}

	async function refreshBatch() {
		if (document.hidden) return;
		const slice = [];
		for (let i = 0; i < BATCH; i++) {
			slice.push(repos[(cursor + i) % repos.length]);
		}
		cursor = (cursor + BATCH) % repos.length;

		const results = await Promise.all(slice.map((repo) => fetchRepo(repo).catch(() => null)));
		const changed = new Set();

		for (const row of results) {
			if (!row) continue;
			const prev = byRepo.get(row.repo);
			const prevKey = (prev?.pulls ?? []).map((p) => `${p.id}:${p.updatedAt}`).join('|');
			const nextKey = row.pulls.map((p) => `${p.id}:${p.updatedAt}`).join('|');
			byRepo.set(row.repo, row);
			if (prevKey !== nextKey) changed.add(row.repo);
		}

		paintAll(changed);
		deadline = Date.now() + REFRESH_MS;
	}

	paintTimes();
	window.setInterval(paintTimes, TIME_TICK_MS);
	window.setInterval(refreshBatch, REFRESH_MS);
	window.setTimeout(refreshBatch, 12_000);

	document.addEventListener('visibilitychange', () => {
		if (!document.hidden && Date.now() >= deadline - 30_000) refreshBatch();
	});
</script>

<style>
	/* Keep styles on #gh-pulse so live PR updates never drop the grid design. */
	#gh-pulse.guns {
		position: relative;
		display: grid;
		gap: 1rem;
		padding: 0.25rem 0 0.5rem;
		isolation: isolate;
	}

	#gh-pulse.guns::before {
		content: '';
		position: absolute;
		inset: -0.5rem -0.75rem auto;
		height: 5.5rem;
		border-radius: 0.35rem;
		background: radial-gradient(ellipse at 20% 40%, color-mix(in srgb, var(--color-secondary) 12%, transparent), transparent 60%),
			radial-gradient(ellipse at 80% 20%, color-mix(in srgb, var(--color-on-surface) 5%, transparent), transparent 55%);
		opacity: 0.65;
		animation: gh-aura 7s ease-in-out infinite;
		pointer-events: none;
		z-index: -1;
	}

	#gh-pulse.guns.is-hot::before {
		animation-duration: 2.4s;
		opacity: 1;
	}

	#gh-pulse :global(.guns-head) {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	#gh-pulse :global(.breath) {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 999px;
		background: var(--color-secondary);
		box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-secondary) 55%, transparent);
		animation: gh-breath 2.8s ease-out infinite;
	}

	#gh-pulse :global(.live-label) {
		color: var(--color-secondary);
		font-weight: 600;
	}

	#gh-pulse :global(.grid) {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 0.85rem;
	}

	#gh-pulse :global(.box) {
		display: grid;
		grid-template-rows: auto 1fr;
		gap: 0.65rem;
		min-width: 0;
		padding: 0.85rem 0.8rem 0.75rem;
		border: 1px solid var(--color-border);
		border-radius: 0.3rem;
		background: color-mix(in srgb, var(--color-surface-light) 90%, transparent);
		animation: gh-settle 520ms cubic-bezier(0.22, 1, 0.36, 1) both;
		animation-delay: calc(var(--i, 0) * 35ms);
	}

	#gh-pulse :global(.box.is-new) {
		animation: gh-rise 700ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	#gh-pulse :global(.box-head) {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		min-width: 0;
	}

	#gh-pulse :global(.avatar) {
		width: 1.75rem;
		height: 1.75rem;
		border-radius: 0.3rem;
		object-fit: cover;
		flex-shrink: 0;
		background: var(--color-surface-container);
	}

	#gh-pulse :global(.repo-name) {
		min-width: 0;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		line-height: 1.3;
		color: var(--color-on-surface);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	#gh-pulse :global(.owner) {
		color: var(--color-on-surface-variant);
		font-weight: 500;
	}

	#gh-pulse :global(.prs) {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.45rem;
		align-content: start;
	}

	#gh-pulse :global(.pr a) {
		display: grid;
		gap: 0.15rem;
		min-width: 0;
		padding: 0.35rem 0.2rem;
		border-radius: 0.2rem;
		transition: background 160ms linear;
	}

	#gh-pulse :global(.pr a:hover) {
		background: var(--color-surface-container-low);
	}

	#gh-pulse :global(.num) {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		color: var(--color-outline);
	}

	#gh-pulse :global(.title) {
		font-family: var(--font-display);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: -0.015em;
		line-height: 1.3;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	#gh-pulse :global(.meta) {
		font-family: var(--font-mono);
		font-size: 0.5625rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-on-surface-variant);
		display: inline-flex;
		gap: 0.4rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	#gh-pulse :global(.when) {
		color: var(--color-outline);
	}

	#gh-pulse :global(.empty) {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-outline);
		padding: 0.35rem 0.2rem;
	}

	@keyframes gh-breath {
		0% {
			transform: scale(1);
			box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-secondary) 45%, transparent);
		}
		70% {
			transform: scale(1.05);
			box-shadow: 0 0 0 0.55rem transparent;
		}
		100% {
			transform: scale(1);
			box-shadow: 0 0 0 0 transparent;
		}
	}

	@keyframes gh-aura {
		0%,
		100% {
			transform: scale(1) translateY(0);
			opacity: 0.5;
		}
		50% {
			transform: scale(1.04) translateY(2px);
			opacity: 0.85;
		}
	}

	@keyframes gh-rise {
		from {
			opacity: 0;
			transform: translateY(-0.55rem);
			filter: blur(1px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
			filter: none;
		}
	}

	@keyframes gh-settle {
		from {
			opacity: 0;
			transform: translateY(0.35rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 1100px) {
		#gh-pulse :global(.grid) {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 720px) {
		#gh-pulse :global(.grid) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 480px) {
		#gh-pulse :global(.grid) {
			grid-template-columns: 1fr;
		}
	}
</style>
