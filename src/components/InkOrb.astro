---
---

<div class="orb" aria-hidden="true">
	<span class="core"></span>
	<span class="ring r1"></span>
	<span class="ring r2"></span>
	<span class="ring r3"></span>
</div>

<style>
	.orb {
		position: relative;
		width: clamp(7.5rem, 18vw, 11rem);
		aspect-ratio: 1;
		flex-shrink: 0;
	}

	.core,
	.ring {
		position: absolute;
		inset: 18%;
		border-radius: 50%;
	}

	.core {
		background:
			radial-gradient(circle at 32% 28%, #fff6ee 0%, transparent 36%),
			radial-gradient(circle at 70% 72%, color-mix(in srgb, var(--color-accent) 70%, #3a0b12) 0%, #9b1d2e 58%, #3a0b12 100%);
		box-shadow: 0 18px 40px color-mix(in srgb, var(--color-accent) 28%, transparent);
		animation: breathe 6.5s ease-in-out infinite;
	}

	.ring {
		inset: 0;
		border: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
		background: transparent;
	}

	.r1 {
		animation: orbit 10s linear infinite;
	}

	.r2 {
		inset: 8%;
		animation: orbit 14s linear infinite reverse;
		opacity: 0.7;
	}

	.r3 {
		inset: -6%;
		border-style: dashed;
		opacity: 0.45;
		animation: orbit 22s linear infinite;
	}

	@keyframes breathe {
		0%,
		100% {
			transform: scale(0.96);
		}
		50% {
			transform: scale(1.04);
		}
	}

	@keyframes orbit {
		to {
			transform: rotate(360deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.core,
		.ring {
			animation: none;
		}
	}
</style>
