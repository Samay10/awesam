---
interface PostItem {
	slug: string;
	title: string;
	description: string;
	pubDate: Date;
	tags: string[];
}

interface Props {
	posts: PostItem[];
	emptyMessage?: string;
}

const { posts, emptyMessage = 'No new notes yet — the press is warm.' } = Astro.props;
const base = import.meta.env.BASE_URL;

function formatDate(date: Date) {
	return date.toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'short',
		day: '2-digit',
	});
}
---

{
	posts.length === 0 ? (
		<p class="empty reveal">{emptyMessage}</p>
	) : (
		<ul class="list">
			{posts.map((post, index) => (
				<li class="reveal" style={`--d: ${index * 60}ms`}>
					<a class="row" href={`${base}posts/${post.slug}/`}>
						<time datetime={post.pubDate.toISOString()}>{formatDate(post.pubDate)}</time>
						<span class="title">{post.title}</span>
						<span class="arrow" aria-hidden="true">↗</span>
					</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--color-border);
	}

	.row {
		display: grid;
		grid-template-columns: 7.5rem minmax(0, 1fr) 1.25rem;
		gap: 1rem;
		align-items: baseline;
		padding: 1.15rem 0.15rem;
		border-bottom: 1px solid var(--color-border);
		transition: background 150ms linear;
	}

	.row:hover {
		background: var(--color-surface-container-low);
	}

	time {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.04em;
		color: var(--color-outline);
		text-transform: uppercase;
	}

	.title {
		font-family: var(--font-display);
		font-size: clamp(1.15rem, 2.2vw, 1.45rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.25;
	}

	.arrow {
		font-size: 0.95rem;
		color: var(--color-outline);
	}

	.row:hover .arrow {
		color: var(--color-secondary);
	}

	.empty {
		margin: 0;
		padding: 1.5rem 0;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
		font-family: var(--font-display);
		font-style: italic;
		font-size: 1.25rem;
		color: var(--color-on-surface-variant);
	}

	.reveal {
		transition-delay: var(--d, 0ms);
	}

	@media (max-width: 640px) {
		.row {
			grid-template-columns: minmax(0, 1fr) 1.25rem;
			gap: 0.65rem;
		}

		time {
			grid-column: 1 / -1;
			margin-bottom: -0.2rem;
		}
	}
</style>
