---
interface Props {
	name: 'articles' | 'hn' | 'x' | 'github' | 'papers';
}

const { name } = Astro.props;
---

{
	name === 'articles' && (
		<svg class="logo" viewBox="0 0 48 48" fill="none" aria-hidden="true">
			<rect x="8" y="6" width="32" height="36" rx="3" stroke="currentColor" stroke-width="2" />
			<path d="M15 16h18M15 23h18M15 30h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
		</svg>
	)
}
{
	name === 'hn' && (
		<svg class="logo" viewBox="0 0 48 48" fill="none" aria-hidden="true">
			<rect width="48" height="48" rx="8" fill="#F0652F" />
			<path d="M14 12h5.2l4.9 10.2L29 12h5.1l-7.8 14.2V36h-5.1V26.2L14 12Z" fill="#fff" />
		</svg>
	)
}
{
	name === 'x' && (
		<svg class="logo" viewBox="0 0 48 48" fill="none" aria-hidden="true">
			<rect width="48" height="48" rx="8" fill="#0F1419" />
			<path
				d="M26.9 22.5 36.4 12h-2.3l-8.2 9.1L19.2 12H12l10 14.1L12 36h2.3l8.8-9.7L28.8 36H36L26.9 22.5Zm-3.1 3.4-.9-1.3L15 13.5h3.4l6.5 9.1.9 1.3 8.5 11.9h-3.4l-6.9-9.9Z"
				fill="#fff"
			/>
		</svg>
	)
}
{
	name === 'github' && (
		<svg class="logo" viewBox="0 0 48 48" fill="none" aria-hidden="true">
			<rect width="48" height="48" rx="8" fill="#24292F" />
			<path
				fill-rule="evenodd"
				clip-rule="evenodd"
				d="M24 10c-7.7 0-14 6.3-14 14 0 6.2 4 11.4 9.6 13.3.7.1 1-.3 1-.7v-2.4c-3.9.8-4.7-1.7-4.7-1.7-.6-1.6-1.5-2-1.5-2-1.3-.9.1-.9.1-.9 1.4.1 2.1 1.4 2.1 1.4 1.2 2.1 3.3 1.5 4.1 1.1.1-.9.5-1.5.8-1.8-3.1-.4-6.4-1.6-6.4-7 0-1.5.5-2.8 1.4-3.8-.1-.4-.6-1.8.1-3.7 0 0 1.2-.4 3.8 1.4a13 13 0 0 1 6.9 0c2.6-1.8 3.8-1.4 3.8-1.4.7 1.9.3 3.3.1 3.7.9 1 1.4 2.3 1.4 3.8 0 5.4-3.3 6.6-6.4 7 .5.4.9 1.3.9 2.6v3.9c0 .4.2.8 1 .7C34 35.4 38 30.2 38 24c0-7.7-6.3-14-14-14Z"
				fill="#fff"
			/>
		</svg>
	)
}
{
	name === 'papers' && (
		<svg class="logo" viewBox="0 0 48 48" fill="none" aria-hidden="true">
			<rect width="48" height="48" rx="8" fill="#B31B1B" />
			<path d="M14 12h14l6 6v18H14V12Z" stroke="#fff" stroke-width="2" />
			<path d="M28 12v6h6" stroke="#fff" stroke-width="2" />
			<path d="M18 24h12M18 29h12M18 34h8" stroke="#fff" stroke-width="2" stroke-linecap="round" />
		</svg>
	)
}

<style>
	.logo {
		width: 3.25rem;
		height: 3.25rem;
		display: block;
		flex-shrink: 0;
	}
</style>
