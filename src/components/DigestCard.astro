---
import type { DigestCard } from '../data/digest';

interface Props {
	card: DigestCard;
}

const { card } = Astro.props;
const tagClass = `tag-${card.source}`;
const spanClass = card.size === 'dense' ? 'dense' : 'wide';
---

<article class:list={['card', spanClass]} data-source={card.source} data-id={card.id}>
	<div class="top">
		<div class="meta-row">
			<span class:list={['badge', tagClass]}>{card.badge}</span>
			<span class="when">{card.meta}</span>
		</div>
		<button type="button" class="title" data-preview={card.id}>{card.title}</button>
		<p class="abstract">{card.abstract}</p>
	</div>

	{
		card.diagram && (
			<div class="diagram">
				<div class="diagram-head">
					<span>{card.diagram.label}</span>
					<span class="accent">{card.diagram.accent}</span>
				</div>
				<div class="cells">
					{card.diagram.cells.map((cell) => (
						<div class="cell">
							<strong>{cell.title}</strong>
							<span>{cell.subtitle}</span>
						</div>
					))}
				</div>
				<p class="diagram-foot">{card.diagram.footer}</p>
			</div>
		)
	}

	{
		card.metricBar && (
			<div class="metric">
				<div class="metric-row">
					<span>{card.metricBar.left}</span>
					<span class="accent">{card.metricBar.right}</span>
				</div>
				<div class="bar">
					<span style={`width:${card.metricBar.width}%`}></span>
				</div>
			</div>
		)
	}

	<div class="foot">
		<div class="stats">
			{card.stats.map((stat) => <span>{stat}</span>)}
		</div>
		<button type="button" class="cta" data-preview={card.id}>
			{card.cta}
			<span aria-hidden="true">→</span>
		</button>
	</div>
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 0.875rem;
		padding: 1.5rem;
		border-radius: 0.25rem;
		background: var(--color-surface-light);
		transition: background 150ms linear;
	}

	.card.dense {
		padding: 1rem;
		gap: 0.65rem;
	}

	.card:hover {
		background: var(--color-surface-container-low);
	}

	.meta-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.badge {
		padding: 0.15rem 0.45rem;
		border-radius: 999px;
		background: var(--color-surface-container);
	}

	.tag-hn {
		color: var(--color-tag-hn);
	}
	.tag-x {
		color: var(--color-tag-x);
	}
	.tag-github {
		color: var(--color-tag-github);
	}
	.tag-papers {
		color: var(--color-tag-papers);
	}
	.tag-articles {
		color: var(--color-tag-articles);
	}

	.when {
		color: var(--color-on-surface-variant);
	}

	.title {
		display: block;
		width: 100%;
		margin: 0.55rem 0 0;
		padding: 0;
		border: 0;
		background: transparent;
		text-align: left;
		cursor: pointer;
		font-family: var(--font-display);
		font-weight: 600;
		letter-spacing: -0.015em;
		color: var(--color-on-surface);
		line-height: 1.25;
		transition: color 150ms linear;
	}

	.wide .title {
		font-size: clamp(1.15rem, 2vw, 1.625rem);
	}

	.dense .title {
		font-size: 1.05rem;
		line-height: 1.3;
	}

	.title:hover {
		color: var(--color-secondary);
	}

	.abstract {
		margin: 0.55rem 0 0;
		color: var(--color-on-surface-variant);
		line-height: 1.55;
		font-size: 0.875rem;
	}

	.dense .abstract {
		font-size: 0.8125rem;
		line-height: 1.45;
	}

	.diagram {
		padding: 0.875rem;
		border-radius: 0.25rem;
		background: var(--color-surface-container);
	}

	.diagram-head,
	.metric-row {
		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--color-outline);
	}

	.accent {
		color: var(--color-secondary);
		font-weight: 600;
	}

	.cells {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.35rem;
		margin-top: 0.55rem;
	}

	.cell {
		padding: 0.55rem 0.4rem;
		border-radius: 0.25rem;
		background: var(--color-surface-light);
		text-align: center;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.03em;
	}

	.cell strong {
		display: block;
		color: var(--color-on-surface);
		font-weight: 600;
	}

	.cell span {
		color: var(--color-on-surface-variant);
	}

	.diagram-foot {
		margin: 0.55rem 0 0;
		text-align: center;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		color: var(--color-on-surface-variant);
	}

	.metric .bar {
		margin-top: 0.4rem;
		height: 0.25rem;
		border-radius: 999px;
		background: var(--color-surface-container);
		overflow: hidden;
	}

	.metric .bar span {
		display: block;
		height: 100%;
		background: var(--color-secondary);
	}

	.foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding-top: 0.25rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--color-on-surface-variant);
	}

	.stats {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--color-on-surface);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
		white-space: nowrap;
	}

	.cta:hover {
		color: var(--color-secondary);
	}
</style>
