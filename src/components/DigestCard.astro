---
import type { DigestCard } from '../data/digest';

interface Props {
	card: DigestCard;
}

const { card } = Astro.props;
const tagClass = `tag-${card.source}`;
const spanClass = card.size === 'dense' ? 'dense' : 'wide';
---

<article class:list={['card', spanClass]} data-source={card.source} data-id={card.id}>
	<a class="hit" href={card.href}>
		<div class="top">
			<div class="meta-row">
				<span class:list={['badge', tagClass]}>{card.badge}</span>
				{card.meta && <span class="when">{card.meta}</span>}
			</div>
			<h3 class="title">{card.title}</h3>
			{card.abstract && <p class="abstract">{card.abstract}</p>}
		</div>
	</a>

	<div class="foot">
		<div class="stats">
			{card.stats.map((stat) => <span>{stat}</span>)}
		</div>
		<a class="cta" href={card.href}>
			{card.cta}
			<span aria-hidden="true">→</span>
		</a>
	</div>
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 0.875rem;
		padding: 1.5rem;
		border-radius: 0.25rem;
		background: var(--color-surface-light);
		transition: background 150ms linear;
	}

	.card.dense {
		padding: 1rem;
		gap: 0.65rem;
	}

	.card:hover {
		background: var(--color-surface-container-low);
	}

	.hit {
		display: grid;
		gap: 0;
		color: inherit;
		text-decoration: none;
		min-width: 0;
	}

	.top {
		padding: 0;
	}

	.meta-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.badge {
		padding: 0.15rem 0.45rem;
		border-radius: 999px;
		background: var(--color-surface-container);
	}

	.tag-hn {
		color: var(--color-tag-hn);
	}
	.tag-x {
		color: var(--color-tag-x);
	}
	.tag-github {
		color: var(--color-tag-github);
	}
	.tag-papers {
		color: var(--color-tag-papers);
	}
	.tag-articles {
		color: var(--color-tag-articles);
	}
	.tag-press {
		color: var(--color-tag-press);
	}
	.tag-reddit {
		color: var(--color-tag-reddit);
	}

	.when {
		color: var(--color-on-surface-variant);
	}

	.title {
		display: block;
		width: 100%;
		margin: 0.55rem 0 0;
		padding: 0;
		border: 0;
		background: transparent;
		text-align: left;
		font-family: var(--font-display);
		font-weight: 600;
		letter-spacing: -0.015em;
		color: var(--color-on-surface);
		line-height: 1.25;
		overflow-wrap: anywhere;
		word-break: break-word;
		text-wrap: balance;
		transition: color 150ms linear;
	}

	.wide .title {
		font-size: clamp(1.15rem, 2vw, 1.625rem);
	}

	.dense .title {
		font-size: 1.05rem;
		line-height: 1.3;
	}

	.card[data-source='x'] .title {
		font-size: clamp(1rem, 1.6vw, 1.2rem);
	}

	.card:hover .title {
		color: var(--color-secondary);
	}

	.abstract {
		margin: 0.55rem 0 0;
		color: var(--color-on-surface-variant);
		line-height: 1.55;
		font-size: 0.875rem;
		display: -webkit-box;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 4;
		line-clamp: 4;
	}

	.dense .abstract {
		font-size: 0.8125rem;
		line-height: 1.45;
	}

	.foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding-top: 0.25rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--color-on-surface-variant);
	}

	.stats {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--color-on-surface);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
		white-space: nowrap;
		text-decoration: none;
	}

	.cta:hover {
		color: var(--color-secondary);
	}
</style>
