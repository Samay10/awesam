---
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;

const feeds = [
	{ label: 'Digest', href: `${base}digest/`, match: '/digest' },
	{ label: 'HN', href: `${base}sections/hn/`, match: '/sections/hn' },
	{ label: 'X', href: `${base}sections/x/`, match: '/sections/x' },
	{ label: 'GitHub', href: `${base}sections/github/`, match: '/sections/github' },
	{ label: 'Papers', href: `${base}sections/papers/`, match: '/sections/papers' },
];
---

<header class="topbar">
	<div class="bar">
		<a class="brand" href={`${base}digest/`}>
			<span class="brand-row">
				<span class="name">{site.name}</span>
				<span class="dot" aria-hidden="true"></span>
			</span>
			<span class="tagline">Notes on systems & craft</span>
		</a>

		<nav class="segment" aria-label="Feeds">
			{
				feeds.map((item) => (
					<a class:list={[{ active: path.includes(item.match) || (item.match === '/digest' && (path === '/' || path.endsWith('/digest/') || path.endsWith('/digest'))) }]} href={item.href}>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="tools">
			<button type="button" class="search" aria-label="Search" title="Search">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
					<circle cx="11" cy="11" r="7"></circle>
					<path d="m20 20-3.5-3.5"></path>
				</svg>
				<span>Search</span>
				<kbd>⌘K</kbd>
			</button>
			<a class="about" href={site.portfolio} target="_blank" rel="noreferrer">About</a>
			<button type="button" class="theme" id="theme-toggle" aria-label="Toggle theme">
				<span class="sun" aria-hidden="true">☀</span>
				<span class="moon" aria-hidden="true">☾</span>
			</button>
		</div>
	</div>
</header>

<script>
	const root = document.documentElement;
	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
		root.setAttribute('data-theme', next);
		localStorage.setItem('theme', next);
	});
</script>

<style>
	.topbar {
		position: fixed;
		inset: 0 0 auto;
		z-index: 50;
		height: 3.5rem;
		background: var(--color-nav);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--color-border);
		padding-top: env(safe-area-inset-top);
	}

	.bar {
		height: 3.5rem;
		max-width: 1280px;
		margin-inline: auto;
		padding-inline: max(2rem, env(safe-area-inset-left)) max(2rem, env(safe-area-inset-right));
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.brand {
		display: flex;
		flex-direction: column;
		min-width: 10rem;
		gap: 0.05rem;
	}

	.brand-row {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.name {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	.dot {
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 999px;
		background: var(--color-secondary);
	}

	.tagline {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-on-surface-variant);
	}

	.segment {
		display: none;
		align-items: center;
		gap: 0.15rem;
		padding: 0.15rem;
		border: 1px solid var(--color-border);
		border-radius: 0.5rem;
		background: var(--color-surface-container);
	}

	.segment a {
		padding: 0.3rem 0.75rem;
		border-radius: 0.25rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--color-on-surface-variant);
		transition: color 150ms linear, background 150ms linear;
	}

	.segment a:hover {
		color: var(--color-on-surface);
	}

	.segment a.active {
		background: var(--color-primary);
		color: var(--color-on-primary);
	}

	.tools {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.65rem;
		min-width: 10rem;
	}

	.search {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		height: 2rem;
		padding: 0 0.65rem;
		border: 1px solid var(--color-border);
		border-radius: 0.25rem;
		background: var(--color-surface-container);
		color: var(--color-on-surface-variant);
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		cursor: pointer;
	}

	.search span,
	.search kbd {
		display: none;
	}

	.about {
		display: none;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-on-surface-variant);
	}

	.about:hover {
		color: var(--color-on-surface);
	}

	.theme {
		width: 2rem;
		height: 2rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--color-border);
		border-radius: 0.25rem;
		background: var(--color-surface-container);
		color: var(--color-on-surface);
		cursor: pointer;
	}

	html[data-theme='light'] .moon,
	html[data-theme='dark'] .sun {
		display: none;
	}

	@media (min-width: 768px) {
		.segment {
			display: inline-flex;
		}

		.about {
			display: inline;
		}

		.search span,
		.search kbd {
			display: inline;
		}

		.search kbd {
			margin-left: 0.35rem;
			padding: 0.1rem 0.3rem;
			border: 1px solid var(--color-border);
			border-radius: 0.2rem;
			background: var(--color-surface);
		}
	}

	@media (max-width: 768px) {
		.bar {
			padding-inline: 1rem;
		}

		.tagline {
			display: none;
		}
	}
</style>
