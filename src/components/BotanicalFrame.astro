<style>
	.flora {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		overflow: hidden;
		opacity: var(--flora-opacity);
		transition:
			opacity 200ms ease,
			filter 200ms ease;
	}

	:global(html[data-theme='dark']) .flora {
		filter: saturate(1.18) brightness(1.06);
	}

	.flora-svg {
		position: absolute;
		pointer-events: none;
		user-select: none;
	}

	.flora-defs-canvas {
		width: 0;
		height: 0;
		overflow: hidden;
	}

	.flora-tl {
		top: calc(3.5rem + env(safe-area-inset-top));
		left: 0;
		width: min(320px, 34vw);
		height: min(250px, 26vw);
	}

	.flora-tr {
		top: calc(3.5rem + env(safe-area-inset-top));
		right: 0;
		width: min(320px, 34vw);
		height: min(250px, 26vw);
		transform: scaleX(-1);
	}

	.flora-bl {
		bottom: 0;
		left: 0;
		width: min(260px, 30vw);
		height: min(200px, 22vw);
		transform: scaleY(-1);
	}

	.flora-br {
		bottom: 0;
		right: 0;
		width: min(260px, 30vw);
		height: min(200px, 22vw);
		transform: scale(-1);
	}

	@media (max-width: 700px) {
		.flora {
			opacity: calc(var(--flora-opacity) * 0.82);
		}

		.flora-tl,
		.flora-tr {
			width: min(200px, 48vw);
			height: min(160px, 36vw);
		}

		.flora-bl,
		.flora-br {
			width: min(160px, 42vw);
			height: min(130px, 30vw);
		}
	}
</style>
