---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeedList from '../../components/FeedList.astro';
import UmeRule from '../../components/UmeRule.astro';
import { fetchHackerNews } from '../../lib/feeds';
import { site } from '../../data/site';

const base = import.meta.env.BASE_URL;
const items = await fetchHackerNews(10);
---

<BaseLayout title={`Hacker News · ${site.name}`} description="Highest-signal Hacker News stories.">
	<section class="detail container-page">
		<a class="back ink-link" href={`${base}digest/`}>← Digest</a>
		<header class="head">
			<h1>Hacker News</h1>
			<UmeRule />
		</header>
		<FeedList items={items} source="hn" />
	</section>
</BaseLayout>

<style>
	.detail {
		padding: 2.5rem 0 4rem;
		display: grid;
		gap: 1.75rem;
	}
	.back {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.head {
		display: grid;
		justify-items: center;
		text-align: center;
		gap: 0.85rem;
		padding: 0.35rem 0 0.25rem;
	}
	h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.15rem, 5.5vw, 2.85rem);
		font-weight: 600;
		letter-spacing: -0.02em;
	}
</style>
