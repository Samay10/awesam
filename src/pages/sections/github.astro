---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeedList from '../../components/FeedList.astro';
import GithubLivePulse from '../../components/GithubLivePulse.astro';
import { fetchGithubWatchPulls, fetchHottestGithubToday } from '../../lib/feeds';
import { site } from '../../data/site';

const base = import.meta.env.BASE_URL;
// Hot search first so it wins scarce unauthenticated search quota; pulse uses /pulls.
const hot = await fetchHottestGithubToday(6);
const pulse = await fetchGithubWatchPulls();
---

<BaseLayout title={`GitHub · ${site.name}`} description="Hottest repos and a live PR pulse across flagship projects.">
	<section class="detail container-page">
		<a class="back ink-link" href={`${base}digest/`}>← Digest</a>
		<header class="head">
			<h1>GitHub</h1>
		</header>

		<div class="block">
			<div class="block-label">Hottest today</div>
			<FeedList items={hot} source="github" plan={[2, 2, 2]} empty="No rising repos in the window — check back on the next sync." />
		</div>

		<div class="block">
			<div class="block-label">Live PR pulse</div>
			<GithubLivePulse initial={pulse} />
		</div>
	</section>
</BaseLayout>

<style>
	.detail {
		padding: 2.5rem 0 4rem;
		display: grid;
		gap: 2rem;
	}
	.back {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.head {
		display: grid;
		gap: 0.55rem;
	}
	h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 2.75rem);
		font-weight: 600;
		letter-spacing: -0.02em;
	}
	.block {
		display: grid;
		gap: 0.85rem;
	}
	.block-label {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-outline);
	}
</style>
