---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeedList from '../../components/FeedList.astro';
import { fetchGithubRepos } from '../../lib/feeds';
import { site } from '../../data/site';

const base = import.meta.env.BASE_URL;
const items = await fetchGithubRepos(10);
---

<BaseLayout title={`GitHub · ${site.name}`} description="Rising GitHub repositories.">
	<section class="detail container-page">
		<a class="back ink-link" href={`${base}digest/`}>← Digest</a>
		<header class="head">
			<h1>GitHub</h1>
		</header>
		<FeedList items={items} source="github" />
	</section>
</BaseLayout>

<style>
	.detail {
		padding: 2.5rem 0 4rem;
		display: grid;
		gap: 1.5rem;
	}
	.back {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.head {
		margin: 0;
	}
	h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 2.75rem);
		font-weight: 600;
		letter-spacing: -0.02em;
	}
</style>
