---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeedList from '../../components/FeedList.astro';
import SectionLogo from '../../components/SectionLogo.astro';
import { fetchGithubRepos } from '../../lib/feeds';
import { site } from '../../data/site';

const base = import.meta.env.BASE_URL;
const items = await fetchGithubRepos(16);
---

<BaseLayout title={`GitHub · ${site.name}`} description="Rising GitHub repositories this week.">
	<section class="detail">
		<div class="container-page">
			<a class="back ink-link reveal" href={`${base}sections/`}>← Sections</a>
			<header class="head reveal">
				<div class="brand-row">
					<SectionLogo name="github" />
					<div>
						<p class="eyebrow">Desk 04</p>
						<h1>GitHub</h1>
					</div>
				</div>
				<p class="lede">New repos gaining stars — the ones people are actually cloning.</p>
			</header>
			<FeedList items={items} />
		</div>
	</section>
</BaseLayout>

<style>
	.detail {
		padding: clamp(2rem, 6vw, 3.5rem) 0 clamp(4rem, 8vw, 6rem);
	}

	.back {
		display: inline-block;
		margin-bottom: 1.5rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.head {
		margin-bottom: 1.75rem;
		padding-bottom: 1.4rem;
		border-bottom: 1px solid var(--color-rule);
	}

	.brand-row {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.eyebrow {
		margin: 0 0 0.35rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.2rem, 6vw, 3.4rem);
		letter-spacing: -0.04em;
		line-height: 1;
	}

	.lede {
		margin: 1rem 0 0;
		max-width: 36rem;
		font-family: var(--font-display);
		font-style: italic;
		color: var(--color-muted);
		font-size: 1.1rem;
	}
</style>
