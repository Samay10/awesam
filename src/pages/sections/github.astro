---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeedList from '../../components/FeedList.astro';
import GithubLivePulse from '../../components/GithubLivePulse.astro';
import UmeRule from '../../components/UmeRule.astro';
import { fetchGithubWatchPulls, fetchHottestGithubToday } from '../../lib/feeds';
import { site } from '../../data/site';

const hot = await fetchHottestGithubToday(6);
const pulse = await fetchGithubWatchPulls();
---

<BaseLayout title={`GitHub · ${site.name}`} description="Hot repositories and live pull requests from flagship projects.">
	<section class="detail container-page">
		<header class="head">
			<h1>GitHub</h1>
			<UmeRule />
		</header>

		<div class="block">
			<h2>Hot Repos</h2>
			<FeedList items={hot} source="github" plan={[2, 2, 2]} empty="Nothing rising right now." />
		</div>

		<div class="block">
			<h2>The Big Guns</h2>
			<GithubLivePulse initial={pulse} />
		</div>
	</section>
</BaseLayout>

<style>
	.detail {
		padding: 2.5rem 0 4rem;
		display: grid;
		gap: 2rem;
	}
	.head {
		display: grid;
		justify-items: center;
		text-align: center;
		gap: 0.85rem;
		padding: 0.35rem 0 0.25rem;
	}
	h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.15rem, 5.5vw, 2.85rem);
		font-weight: 600;
		letter-spacing: -0.02em;
	}
	.block {
		display: grid;
		gap: 0.85rem;
	}
	h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.15rem;
		font-weight: 600;
		letter-spacing: -0.015em;
	}
</style>
