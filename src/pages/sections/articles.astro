---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import SectionLogo from '../../components/SectionLogo.astro';
import { site } from '../../data/site';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('posts'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map((post) => ({
		slug: post.id,
		title: post.data.title,
		description: post.data.description,
		pubDate: post.data.pubDate,
		tags: post.data.tags,
	}));
---

<BaseLayout title={`Articles · ${site.name}`} description="Articles and notes by Samay Ashar.">
	<section class="detail">
		<div class="container-page">
			<a class="back ink-link reveal" href={`${base}sections/`}>← Sections</a>
			<header class="head reveal">
				<div class="brand-row">
					<SectionLogo name="articles" />
					<div>
						<p class="eyebrow">Desk 01</p>
						<h1>Articles by me</h1>
					</div>
				</div>
				<p class="lede">Notes from the press — systems, craft, and learning along the way.</p>
			</header>
			<PostList posts={posts} emptyMessage="No new notes yet — the press is warm." />
		</div>
	</section>
</BaseLayout>

<style>
	.detail {
		padding: clamp(2rem, 6vw, 3.5rem) 0 clamp(4rem, 8vw, 6rem);
	}

	.back {
		display: inline-block;
		margin-bottom: 1.5rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.head {
		margin-bottom: 1.75rem;
		padding-bottom: 1.4rem;
		border-bottom: 1px solid var(--color-rule);
	}

	.brand-row {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.eyebrow {
		margin: 0 0 0.35rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.2rem, 6vw, 3.4rem);
		letter-spacing: -0.04em;
		line-height: 1;
	}

	.lede {
		margin: 1rem 0 0;
		max-width: 36rem;
		font-family: var(--font-display);
		font-style: italic;
		color: var(--color-muted);
		font-size: 1.1rem;
	}
</style>
