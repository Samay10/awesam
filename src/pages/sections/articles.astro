---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { site } from '../../data/site';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('posts'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map((post) => ({
		slug: post.id,
		title: post.data.title,
		description: post.data.description,
		pubDate: post.data.pubDate,
		tags: post.data.tags,
	}));
---

<BaseLayout title={`Articles · ${site.name}`} description="Articles by Samay Ashar.">
	<section class="detail container-page">
		<a class="back ink-link" href={`${base}digest/`}>← Digest</a>
		<header class="head">
			<p class="eyebrow">Source desk · Articles</p>
			<h1>Articles by me</h1>
			<p class="lede">Notes from the press.</p>
		</header>
		<PostList posts={posts} />
	</section>
</BaseLayout>

<style>
	.detail {
		padding: 2.5rem 0 4rem;
	}
	.back {
		display: inline-block;
		margin-bottom: 1.25rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.eyebrow {
		margin: 0 0 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-secondary);
		font-weight: 600;
	}
	h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 2.75rem);
		font-weight: 600;
		letter-spacing: -0.02em;
	}
	.lede {
		margin: 0.75rem 0 1.5rem;
		color: var(--color-on-surface-variant);
		max-width: 36rem;
	}
	.head {
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--color-border);
		margin-bottom: 0.5rem;
	}
</style>
