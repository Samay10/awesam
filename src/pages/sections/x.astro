---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeedList from '../../components/FeedList.astro';
import UmeRule from '../../components/UmeRule.astro';
import { loadCatalog } from '../../lib/catalog';
import { site } from '../../data/site';

const catalog = await loadCatalog();
---

<BaseLayout title={`X · ${site.name}`} description="X / lab signals.">
	<section class="detail container-page">
		<header class="head">
			<h1>X</h1>
			<UmeRule />
		</header>
		<FeedList stories={catalog.x} />
	</section>
</BaseLayout>

<style>
	.detail {
		padding: 2.75rem 0 3.5rem;
		display: grid;
		gap: 2.75rem;
	}
	.head {
		position: relative;
		z-index: 1;
		display: grid;
		justify-items: center;
		text-align: center;
		gap: 1rem;
		padding: 1.25rem 0 0.5rem;
	}
	h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.15rem, 5.5vw, 2.85rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.12;
	}
</style>
