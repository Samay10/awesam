---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeedList from '../../components/FeedList.astro';
import UmeRule from '../../components/UmeRule.astro';
import { fetchXTimeline } from '../../lib/feeds';
import { site } from '../../data/site';

const items = await fetchXTimeline(10);
---

<BaseLayout title={`X · ${site.name}`} description="X / lab signals.">
	<section class="detail container-page">
		<header class="head">
			<h1>X</h1>
			<UmeRule />
		</header>
		<FeedList items={items} source="x" />
	</section>
</BaseLayout>

<style>
	.detail {
		padding: 2.5rem 0 4rem;
		display: grid;
		gap: 1.75rem;
	}
	.head {
		display: grid;
		justify-items: center;
		text-align: center;
		gap: 0.85rem;
		padding: 0.35rem 0 0.25rem;
	}
	h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.15rem, 5.5vw, 2.85rem);
		font-weight: 600;
		letter-spacing: -0.02em;
	}
</style>
