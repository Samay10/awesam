---
import BaseLayout from '../layouts/BaseLayout.astro';
import DigestCard from '../components/DigestCard.astro';
import UmeRule from '../components/UmeRule.astro';
import { buildLiveDigestBands } from '../lib/buildDigest';
import { site } from '../data/site';

const digestBands = await buildLiveDigestBands();
---

<BaseLayout
	title={`${site.name} — The Technical Digest`}
	description="Notes on systems architecture, mathematical precision, foundational AI research, and programming craft."
>
	<div class="canvas container-page">
		<header class="mast">
			<h1>The Technical Digest</h1>
			<UmeRule />
			<p class="lede">
				Notes on systems architecture, mathematical precision, foundational AI research, and programming craft.
			</p>
		</header>

		{
			digestBands.map((band) => (
				<section class="band" data-band={band.id}>
					<div class:list={['grid', band.cards.length === 3 ? 'three' : 'two']}>
						{band.cards.map((card) => (
							<DigestCard card={card} />
						))}
					</div>
				</section>
			))
		}
	</div>
</BaseLayout>

<style>
	.canvas {
		padding: 2.75rem 0 3.5rem;
		display: grid;
		gap: 2.75rem;
	}

	.mast {
		position: relative;
		z-index: 1;
		display: grid;
		justify-items: center;
		text-align: center;
		gap: 1rem;
		padding: 1.25rem 0 0.5rem;
	}

	h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.15rem, 5.5vw, 2.85rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.12;
	}

	.lede {
		margin: 0;
		max-width: 38rem;
		font-size: 1rem;
		line-height: 1.65;
		color: var(--color-on-surface-variant);
	}

	.band {
		display: grid;
		gap: 0.875rem;
	}

	.grid {
		display: grid;
		gap: 1.25rem;
	}

	.grid.two,
	.grid.three {
		grid-template-columns: 1fr;
	}

	@media (min-width: 900px) {
		.grid.two {
			grid-template-columns: 1fr 1fr;
		}

		.grid.three {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
