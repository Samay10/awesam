---
import BaseLayout from '../layouts/BaseLayout.astro';
import DigestCard from '../components/DigestCard.astro';
import { countBySource, digestBands, digestSynthesis } from '../data/digest';
import { site } from '../data/site';

const counts = countBySource(digestBands);
const catalog = Object.fromEntries(digestBands.flatMap((band) => band.cards.map((card) => [card.id, card])));
---

<BaseLayout
	title={`${site.name} — The Technical Digest`}
	description="Notes on systems architecture, mathematical precision, foundational AI research, and programming craft."
>
	<div class="canvas container-page">
		<header class="mast">
			<div class="issue">
				<span class="vol">Volume IV</span>
				<span class="sep">·</span>
				<span>Issue 298</span>
				<span class="sep">·</span>
				<span class="on">Curated Technical Edition</span>
			</div>

			<div class="hero-grid">
				<div class="hero-copy">
					<h1>The Technical Digest</h1>
					<p>
						Notes on systems architecture, mathematical precision, foundational AI research, and programming craft.
						Synthesized daily for practicing architects and principal builders.
					</p>
				</div>
				<div class="partition">
					<span class="partition-label">Active Source Partition</span>
					<div class="filters" id="source-filters">
						<button type="button" class="chip is-on" data-filter="all">All ({counts.all})</button>
						<button type="button" class="chip" data-filter="hn">HN ({counts.hn})</button>
						<button type="button" class="chip" data-filter="x">X / Lab ({counts.x})</button>
						<button type="button" class="chip" data-filter="github">GitHub ({counts.github})</button>
						<button type="button" class="chip" data-filter="papers">ArXiv ({counts.papers})</button>
					</div>
				</div>
			</div>
		</header>

		{
			digestBands.map((band) => (
				<section class="band" data-band={band.id}>
					<div class:list={['grid', band.cards.length === 3 ? 'three' : 'two']}>
						{band.cards.map((card) => (
							<DigestCard card={card} />
						))}
					</div>
				</section>
			))
		}

		<section class="synthesis">
			<div class="syn-head">
				<div>
					<span class="band-label">Journal Synthesis</span>
					<h3>The Macro Architecture Horizon</h3>
				</div>
				<span class="engine">Synthesis Engine stub · Live APIs next</span>
			</div>
			<div class="syn-grid">
				{
					digestSynthesis.map((item) => (
						<div>
							<strong>{item.title}</strong>
							<p>{item.body}</p>
						</div>
					))
				}
			</div>
		</section>
	</div>

	<div class="modal" id="preview-modal" hidden>
		<div class="dialog" role="dialog" aria-modal="true" aria-labelledby="modal-title">
			<div class="dialog-head">
				<div class="dialog-meta">
					<span class="badge" id="modal-tag">HN</span>
					<span id="modal-read">5 MIN READ</span>
				</div>
				<button type="button" class="close" id="modal-close" aria-label="Close">×</button>
			</div>
			<div class="dialog-body">
				<span class="eyebrow">Executive Abstract</span>
				<h3 id="modal-title">Article Title</h3>
				<p id="modal-content"></p>
				<div class="dialog-foot">
					<div>
						<span class="eyebrow">Primary Source</span>
						<span id="modal-source-id"></span>
					</div>
					<a id="modal-link" href="#" target="_blank" rel="noreferrer">
						Read Original Wire ↗
					</a>
				</div>
			</div>
		</div>
	</div>
</BaseLayout>

<script define:vars={{ catalog }}>
	const filters = document.getElementById('source-filters');
	const cards = [...document.querySelectorAll('.card')];
	const modal = document.getElementById('preview-modal');
	const modalTag = document.getElementById('modal-tag');
	const modalRead = document.getElementById('modal-read');
	const modalTitle = document.getElementById('modal-title');
	const modalContent = document.getElementById('modal-content');
	const modalSource = document.getElementById('modal-source-id');
	const modalLink = document.getElementById('modal-link');

	filters?.addEventListener('click', (event) => {
		const button = event.target.closest('[data-filter]');
		if (!button) return;
		const next = button.dataset.filter || 'all';
		filters.querySelectorAll('.chip').forEach((chip) => chip.classList.toggle('is-on', chip === button));
		cards.forEach((card) => {
			card.hidden = next !== 'all' && card.dataset.source !== next;
		});
		document.querySelectorAll('.band').forEach((band) => {
			const visible = [...band.querySelectorAll('.card')].some((card) => !card.hidden);
			band.hidden = !visible;
		});
	});

	function openPreview(id) {
		const item = catalog[id];
		if (!item || !modal) return;
		modalTag.textContent = item.badge;
		modalRead.textContent = item.meta;
		modalTitle.textContent = item.title;
		modalContent.textContent = item.abstract;
		modalSource.textContent = item.stats.join(' · ');
		modalLink.href = item.href;
		modal.hidden = false;
		document.body.style.overflow = 'hidden';
	}

	function closePreview() {
		if (!modal) return;
		modal.hidden = true;
		document.body.style.overflow = '';
	}

	document.querySelectorAll('[data-preview]').forEach((node) => {
		node.addEventListener('click', () => openPreview(node.dataset.preview));
	});
	document.getElementById('modal-close')?.addEventListener('click', closePreview);
	modal?.addEventListener('click', (event) => {
		if (event.target === modal) closePreview();
	});
	window.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') closePreview();
	});
</script>

<style>
	.canvas {
		padding: 2.5rem 0 3.5rem;
		display: grid;
		gap: 2.5rem;
	}

	.mast {
		display: grid;
		gap: 1.25rem;
	}

	.issue {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		padding-bottom: 0.65rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-on-surface-variant);
	}

	.vol,
	.band-label {
		color: var(--color-secondary);
		font-weight: 600;
	}

	.on {
		color: var(--color-on-surface);
	}

	.sep {
		color: var(--color-outline);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
		align-items: end;
	}

	h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 2.75rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.15;
	}

	.hero-copy p {
		margin: 0.65rem 0 0;
		max-width: 42rem;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--color-on-surface-variant);
	}

	.partition {
		display: grid;
		gap: 0.4rem;
	}

	.partition-label {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-outline);
	}

	.filters {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		padding: 0.25rem;
		border-radius: 0.25rem;
		background: var(--color-surface-container);
	}

	.chip {
		padding: 0.3rem 0.65rem;
		border: 0;
		border-radius: 0.25rem;
		background: transparent;
		color: var(--color-on-surface-variant);
		font-family: var(--font-mono);
		font-size: 0.625rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		cursor: pointer;
	}

	.chip.is-on {
		background: var(--color-primary);
		color: var(--color-on-primary);
	}

	.band {
		display: grid;
		gap: 0.875rem;
	}

	.grid {
		display: grid;
		gap: 1.25rem;
	}

	.grid.two {
		grid-template-columns: 1fr;
	}

	.grid.three {
		grid-template-columns: 1fr;
	}

	.synthesis {
		padding: 1.5rem;
		border-radius: 0.25rem;
		background: var(--color-surface-container-low);
		display: grid;
		gap: 1.25rem;
	}

	.syn-head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.syn-head h3 {
		margin: 0.2rem 0 0;
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 600;
	}

	.engine {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--color-outline);
	}

	.syn-grid {
		display: grid;
		gap: 1.25rem;
	}

	.syn-grid strong {
		display: block;
		margin-bottom: 0.35rem;
		font-family: var(--font-display);
		color: var(--color-on-surface);
	}

	.syn-grid p {
		margin: 0;
		color: var(--color-on-surface-variant);
		line-height: 1.55;
		font-size: 0.8125rem;
	}

	.modal {
		position: fixed;
		inset: 0;
		z-index: 60;
		display: grid;
		place-items: center;
		padding: 2rem;
		background: rgba(0, 0, 0, 0.45);
	}

	.modal[hidden] {
		display: none;
	}

	.dialog {
		width: min(720px, 100%);
		max-height: 82vh;
		overflow: auto;
		background: var(--color-surface-light);
		border: 1px solid var(--color-border);
		border-radius: 0.25rem;
	}

	.dialog-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.9rem 1.25rem;
		background: var(--color-surface-container-low);
		border-bottom: 1px solid var(--color-border);
	}

	.dialog-meta {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-on-surface-variant);
	}

	.dialog-meta .badge {
		padding: 0.15rem 0.45rem;
		border-radius: 999px;
		background: var(--color-surface-container);
		color: var(--color-secondary);
		font-weight: 600;
	}

	.close {
		width: 1.75rem;
		height: 1.75rem;
		border: 0;
		border-radius: 0.25rem;
		background: transparent;
		color: var(--color-on-surface-variant);
		font-size: 1.25rem;
		cursor: pointer;
	}

	.dialog-body {
		padding: 1.35rem;
		display: grid;
		gap: 0.75rem;
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-outline);
	}

	#modal-title {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	#modal-content {
		margin: 0;
		color: var(--color-on-surface-variant);
		line-height: 1.6;
	}

	.dialog-foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.9rem 1rem;
		border-radius: 0.25rem;
		background: var(--color-surface-container-low);
	}

	#modal-source-id {
		display: block;
		margin-top: 0.2rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}

	#modal-link {
		display: inline-flex;
		align-items: center;
		padding: 0.45rem 0.8rem;
		border-radius: 0.25rem;
		background: var(--color-primary);
		color: var(--color-on-primary);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	@media (min-width: 900px) {
		.hero-grid {
			grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
		}

		.partition {
			justify-items: end;
			text-align: right;
		}

		.grid.two {
			grid-template-columns: 1fr 1fr;
		}

		.grid.three {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.syn-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
