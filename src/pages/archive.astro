---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { site } from '../data/site';

const all = (await getCollection('posts'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const tags = [...new Set(all.flatMap((post) => post.data.tags))].sort();

const posts = all.map((post) => ({
	slug: post.id,
	title: post.data.title,
	description: post.data.description,
	pubDate: post.data.pubDate,
	tags: post.data.tags,
}));

const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`Archive · ${site.name}`} description="All notes from the AweSam press.">
	<section class="archive">
		<div class="container-page">
			<header class="head reveal">
				<p class="eyebrow">The bound volume</p>
				<h1>Archive</h1>
				<p class="lede">{site.tagline}</p>
			</header>

			{
				tags.length > 0 && (
					<div class="filters reveal" id="tag-filters" data-active="all">
						<button type="button" class="chip is-on" data-tag="all">
							All
						</button>
						{tags.map((tag) => (
							<button type="button" class="chip" data-tag={tag}>
								{tag}
							</button>
						))}
					</div>
				)
			}

			<div id="archive-list">
				<ul class="list">
					{
						posts.map((post, index) => (
							<li
								class="reveal item"
								style={`--d: ${index * 50}ms`}
								data-tags={post.tags.join(',')}
							>
								<a class="row" href={`${base}posts/${post.slug}/`}>
									<time datetime={post.pubDate.toISOString()}>
										{post.pubDate.toLocaleDateString('en-US', {
											year: 'numeric',
											month: 'short',
											day: '2-digit',
										})}
									</time>
									<span class="copy">
										<span class="title">{post.title}</span>
										<span class="desc">{post.description}</span>
									</span>
									<span class="arrow" aria-hidden="true">↗</span>
								</a>
							</li>
						))
					}
				</ul>
				<p class="empty" id="archive-empty" hidden>No notes match this mark.</p>
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	const root = document.getElementById('tag-filters');
	const items = [...document.querySelectorAll<HTMLElement>('.item')];
	const empty = document.getElementById('archive-empty');

	root?.addEventListener('click', (event) => {
		const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-tag]');
		if (!button) return;
		const tag = button.dataset.tag || 'all';
		root.querySelectorAll('.chip').forEach((chip) => chip.classList.toggle('is-on', chip === button));
		let visible = 0;
		items.forEach((item) => {
			const tags = (item.dataset.tags || '').split(',').filter(Boolean);
			const show = tag === 'all' || tags.includes(tag);
			item.hidden = !show;
			if (show) visible += 1;
		});
		if (empty) empty.hidden = visible > 0;
	});
</script>

<style>
	.archive {
		padding: clamp(2.75rem, 7vw, 4.5rem) 0 clamp(4rem, 8vw, 6rem);
	}

	.head {
		max-width: 40rem;
		margin-bottom: 2rem;
	}

	.eyebrow {
		margin: 0 0 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.8rem, 8vw, 4.5rem);
		font-weight: 650;
		letter-spacing: -0.04em;
		line-height: 0.95;
	}

	.lede {
		margin: 1rem 0 0;
		font-size: 1.1rem;
		line-height: 1.55;
		color: var(--color-muted);
		font-style: italic;
		font-family: var(--font-display);
	}

	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-bottom: 1.5rem;
	}

	.chip {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: 0.4rem 0.7rem;
		border: 1px solid var(--color-rule);
		background: transparent;
		color: var(--color-muted);
		cursor: pointer;
		border-radius: 0.15rem;
		transition:
			color 160ms ease,
			border-color 160ms ease,
			background 160ms ease;
	}

	.chip:hover,
	.chip.is-on {
		color: var(--color-ink);
		border-color: color-mix(in srgb, var(--color-ink) 35%, transparent);
		background: var(--color-paper-deep);
	}

	.chip.is-on {
		color: var(--color-accent);
		border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
	}

	.list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--color-rule);
	}

	.row {
		display: grid;
		grid-template-columns: 7.5rem minmax(0, 1fr) 1.25rem;
		gap: 1rem;
		align-items: start;
		padding: 1.25rem 0.15rem;
		border-bottom: 1px solid var(--color-rule);
	}

	.row:hover {
		background: color-mix(in srgb, var(--color-paper-deep) 70%, transparent);
	}

	time {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.04em;
		color: var(--color-muted);
		text-transform: uppercase;
		padding-top: 0.35rem;
	}

	.copy {
		display: grid;
		gap: 0.35rem;
		min-width: 0;
	}

	.title {
		font-family: var(--font-display);
		font-size: clamp(1.2rem, 2.4vw, 1.55rem);
		font-weight: 550;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	.desc {
		font-size: 0.95rem;
		line-height: 1.5;
		color: var(--color-muted);
	}

	.arrow {
		padding-top: 0.35rem;
		color: var(--color-muted);
		transition:
			transform 180ms ease,
			color 180ms ease;
	}

	.row:hover .arrow {
		color: var(--color-accent);
		transform: translate(2px, -2px);
	}

	.empty {
		margin: 1.5rem 0 0;
		font-family: var(--font-display);
		font-style: italic;
		color: var(--color-muted);
	}

	.reveal {
		transition-delay: var(--d, 0ms);
	}

	@media (max-width: 640px) {
		.row {
			grid-template-columns: minmax(0, 1fr) 1.25rem;
		}

		time {
			grid-column: 1 / -1;
			padding-top: 0;
		}
	}
</style>
