---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import InkOrb from '../components/InkOrb.astro';
import GravityField from '../components/GravityField.astro';
import { loadWire } from '../lib/feeds.ts';
import { site } from '../data/site';

const sections = await loadWire();
const fetchedAt = new Date().toLocaleString('en-US', {
	month: 'short',
	day: 'numeric',
	year: 'numeric',
	hour: 'numeric',
	minute: '2-digit',
	timeZoneName: 'short',
});
const liveCount = sections.reduce((sum, section) => sum + section.items.length, 0);
---

<BaseLayout
	title={`The Wire · ${site.name}`}
	description="A live desk of Hacker News, rising GitHub repos, arXiv papers, and systems/AI field notes."
>
	<section class="desk">
		<div class="container-page">
			<div class="hero reveal">
				<div class="copy">
					<p class="eyebrow">The live desk</p>
					<h1>The Wire</h1>
					<p class="lede">
						HN, GitHub, arXiv, and the open web — pulled into one press room. Skip around, stay a while.
					</p>
					<div class="stats">
						<span>{liveCount} marks on the desk</span>
						<span>{fetchedAt}</span>
					</div>
				</div>
				<InkOrb />
			</div>

			<nav class="jump" aria-label="Wire sections">
				{
					sections.map((section) => (
						<a class="jump-link" href={`#${section.id}`}>
							<span class="kicker">{section.kicker}</span>
							<span>{section.label}</span>
							<span class="count">{section.items.length}</span>
						</a>
					))
				}
			</nav>

			<div class="filters" id="wire-filters">
				<button type="button" class="chip is-on" data-filter="all">All</button>
				{
					sections.map((section) => (
						<button type="button" class="chip" data-filter={section.id}>
							{section.label}
						</button>
					))
				}
			</div>
		</div>
	</section>

	{
		sections.map((section) => (
			<section class="lane reveal" id={section.id} data-lane={section.id}>
				<div class="container-page">
					<header class="lane-head">
						<div>
							<p class="eyebrow">{section.kicker}</p>
							<h2>{section.label}</h2>
							<p class="blurb">{section.blurb}</p>
						</div>
					</header>

					{section.items.length === 0 ? (
						<p class="empty">The wire is quiet here — try again in a few minutes.</p>
					) : (
						<ol class="marks">
							{section.items.map((item, index) => (
								<li>
									<a class="mark" href={item.href} target="_blank" rel="noreferrer">
										<span class="idx">{String(index + 1).padStart(2, '0')}</span>
										<span class="body">
											<span class="title">{item.title}</span>
											{item.summary && <span class="summary">{item.summary}</span>}
											<span class="meta">
												{item.source}
												{item.meta ? ` · ${item.meta}` : ''}
											</span>
										</span>
										<span class="arrow" aria-hidden="true">↗</span>
									</a>
								</li>
							))}
						</ol>
					)}
				</div>
			</section>
		))
	}

	<section class="play reveal">
		<div class="container-page">
			<p class="eyebrow">Press room idle</p>
			<p class="hint">Click the tray to drop type. Hold to pour. A little Rare UI gravity, AweSam ink.</p>
			<GravityField />
		</div>
	</section>
</BaseLayout>

<script>
	const filters = document.getElementById('wire-filters');
	const lanes = [...document.querySelectorAll<HTMLElement>('[data-lane]')];

	filters?.addEventListener('click', (event) => {
		const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
		if (!button) return;
		const next = button.dataset.filter || 'all';
		filters.querySelectorAll('.chip').forEach((chip) => chip.classList.toggle('is-on', chip === button));
		lanes.forEach((lane) => {
			lane.hidden = next !== 'all' && lane.dataset.lane !== next;
		});
	});
</script>

<style>
	.desk {
		padding: clamp(2.4rem, 7vw, 4.2rem) 0 1.5rem;
	}

	.hero {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
		padding-bottom: 1.75rem;
		border-bottom: 1px solid var(--color-rule);
	}

	.eyebrow {
		margin: 0 0 0.7rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(3.2rem, 10vw, 6.2rem);
		font-weight: 650;
		letter-spacing: -0.05em;
		line-height: 0.9;
	}

	.lede {
		margin: 1rem 0 0;
		max-width: 34rem;
		font-family: var(--font-display);
		font-style: italic;
		font-size: 1.15rem;
		line-height: 1.5;
		color: var(--color-muted);
	}

	.stats {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem 1.25rem;
		margin-top: 1.35rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.jump {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.75rem;
		margin: 1.5rem 0 1rem;
	}

	.jump-link {
		display: grid;
		gap: 0.2rem;
		padding: 0.85rem 0.9rem;
		border: 1px solid var(--color-rule);
		background: color-mix(in srgb, var(--color-paper-deep) 45%, transparent);
		transition:
			transform 180ms ease,
			border-color 180ms ease,
			background 180ms ease;
	}

	.jump-link:hover {
		transform: translateY(-2px);
		border-color: color-mix(in srgb, var(--color-accent) 40%, var(--color-rule));
		background: var(--color-paper-deep);
	}

	.jump-link .kicker,
	.jump-link .count {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.jump-link span:nth-child(2) {
		font-family: var(--font-display);
		font-size: 1.2rem;
		letter-spacing: -0.03em;
	}

	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.chip {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: 0.4rem 0.7rem;
		border: 1px solid var(--color-rule);
		background: transparent;
		color: var(--color-muted);
		cursor: pointer;
		border-radius: 0.15rem;
	}

	.chip:hover,
	.chip.is-on {
		color: var(--color-ink);
		background: var(--color-paper-deep);
	}

	.chip.is-on {
		color: var(--color-accent);
		border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
	}

	.lane {
		padding: 2.4rem 0;
		border-top: 1px solid var(--color-rule);
	}

	.lane-head {
		max-width: 40rem;
		margin-bottom: 1.25rem;
	}

	.lane-head h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.8rem, 4vw, 2.5rem);
		letter-spacing: -0.03em;
	}

	.blurb {
		margin: 0.55rem 0 0;
		color: var(--color-muted);
		line-height: 1.55;
	}

	.marks {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--color-rule);
	}

	.mark {
		display: grid;
		grid-template-columns: 2.4rem minmax(0, 1fr) 1.1rem;
		gap: 0.85rem;
		align-items: start;
		padding: 1.05rem 0.15rem;
		border-bottom: 1px solid var(--color-rule);
	}

	.mark:hover {
		background: color-mix(in srgb, var(--color-paper-deep) 70%, transparent);
	}

	.idx {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.06em;
		color: var(--color-muted);
		padding-top: 0.35rem;
	}

	.body {
		display: grid;
		gap: 0.3rem;
		min-width: 0;
	}

	.title {
		font-family: var(--font-display);
		font-size: clamp(1.1rem, 2vw, 1.4rem);
		letter-spacing: -0.02em;
		line-height: 1.25;
	}

	.summary,
	.meta {
		font-size: 0.92rem;
		line-height: 1.5;
		color: var(--color-muted);
	}

	.meta {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.arrow {
		color: var(--color-muted);
		padding-top: 0.3rem;
		transition:
			transform 180ms ease,
			color 180ms ease;
	}

	.mark:hover .arrow {
		color: var(--color-accent);
		transform: translate(2px, -2px);
	}

	.empty {
		margin: 0;
		padding: 1.2rem 0;
		font-family: var(--font-display);
		font-style: italic;
		color: var(--color-muted);
	}

	.play {
		padding: 1rem 0 4rem;
	}

	.hint {
		margin: 0 0 0.85rem;
		color: var(--color-muted);
		font-style: italic;
		font-family: var(--font-display);
	}

	@media (max-width: 800px) {
		.hero {
			flex-direction: column;
			align-items: flex-start;
		}

		.jump {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 640px) {
		.mark {
			grid-template-columns: minmax(0, 1fr) 1.1rem;
		}

		.idx {
			display: none;
		}
	}
</style>
