---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UmeRule from '../../components/UmeRule.astro';
import { allStories, loadCatalog, type Story } from '../../lib/catalog';
import { site } from '../../data/site';

export async function getStaticPaths() {
	const catalog = await loadCatalog();
	return allStories(catalog).map((story) => ({
		params: { id: story.id },
		props: { story },
	}));
}

interface Props {
	story: Story;
}

const { story } = Astro.props;
const base = import.meta.env.BASE_URL;
const sectionHref =
	story.source === 'hn'
		? `${base}sections/hn/`
		: story.source === 'x'
			? `${base}sections/x/`
			: story.source === 'github'
				? `${base}sections/github/`
				: story.source === 'papers'
					? `${base}sections/papers/`
					: `${base}digest/`;
const originalLabel =
	story.source === 'github' ? 'View repository' : story.source === 'papers' ? 'Read the paper' : 'Read original';
---

<BaseLayout title={`${story.title} · ${site.name}`} description={story.lede}>
	<article class="read">
		<div class="container-page">
			<a class="back ink-link" href={sectionHref}>← {story.badge}</a>

			<header class="head">
				<p class="meta">
					<span>{story.sourceLabel}</span>
					<span class="sep">·</span>
					<span>{story.meta}</span>
				</p>
				<h1>{story.title}</h1>
				<UmeRule />
				{story.whyRead && <p class="dek">{story.whyRead}</p>}
			</header>

			<div class="body measure">
				{story.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
				{story.takeaway && (
					<p class="takeaway">
						<span class="takeaway-label">Takeaway</span>
						{story.takeaway}
					</p>
				)}
			</div>

			<footer class="origin">
				<p>
					AweSam briefing — continue on the original for source material, discussion, and updates.
				</p>
				<a class="origin-link" href={story.originalHref} target="_blank" rel="noreferrer">
					{originalLabel} ↗
				</a>
			</footer>
		</div>
	</article>
</BaseLayout>

<style>
	.read {
		padding: clamp(2rem, 6vw, 3.5rem) 0 clamp(4rem, 8vw, 6rem);
	}

	.back {
		display: inline-block;
		margin-bottom: 1.75rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.head {
		max-width: 42rem;
		margin-bottom: 2rem;
		display: grid;
		gap: 0.9rem;
	}

	.meta {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-on-surface-variant);
	}

	.sep {
		margin-inline: 0.45rem;
		opacity: 0.55;
	}

	h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.65rem, 4.2vw, 2.45rem);
		font-weight: 650;
		letter-spacing: -0.03em;
		line-height: 1.18;
		overflow-wrap: anywhere;
		text-wrap: pretty;
	}

	.dek {
		margin: 0;
		font-size: 1.05rem;
		line-height: 1.55;
		color: var(--color-on-surface-variant);
		font-family: var(--font-body);
		font-style: normal;
		max-width: 38rem;
	}

	.body {
		max-width: 40rem;
	}

	.body p {
		margin: 0 0 1.35rem;
		font-size: 1.0625rem;
		line-height: 1.72;
		overflow-wrap: break-word;
		text-wrap: pretty;
	}

	.takeaway {
		margin-top: 1.75rem !important;
		padding: 1rem 0 0;
		border-top: 1px solid color-mix(in srgb, var(--color-outline-variant) 55%, transparent);
		font-size: 1.05rem !important;
		line-height: 1.65 !important;
		color: var(--color-on-surface);
	}

	.takeaway-label {
		display: block;
		margin-bottom: 0.45rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-secondary);
	}

	.origin {
		max-width: 40rem;
		margin-top: 2.25rem;
		padding: 1.05rem 1.15rem;
		border-radius: 0.3rem;
		background: var(--color-surface-container-low);
		display: grid;
		gap: 0.85rem;
	}

	.origin p {
		margin: 0;
		color: var(--color-on-surface-variant);
		line-height: 1.55;
	}

	.origin-link {
		justify-self: start;
		display: inline-flex;
		align-items: center;
		padding: 0.5rem 0.85rem;
		border-radius: 0.25rem;
		background: var(--color-primary);
		color: var(--color-on-primary);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		text-decoration: none;
	}
</style>
